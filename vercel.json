{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": { "maxLambdaSize": "50mb" }
    },
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.py" },
    { "src": "/health",   "dest": "/api/index.py" },
    { "src": "/app/(.*)", "dest": "/frontend/$1"  },
    { "src": "/",         "dest": "/frontend/login.html" }
  ]
}
